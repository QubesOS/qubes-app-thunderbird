{
  "manifest_version": 2,
  "name": "Qubes Attachments",
  "description": "Qubes actions for attachments: \"Open in DispVM\" and \"Send to VM\"",
  "version": "@VERSION",
  "author": "Invisible Things Lab",
  "homepage_url": "https://www.qubes-os.org/",
  "browser_specific_settings": {
    "gecko": {
      "id": "qubes-attachment@qubes-os.org",
      "strict_min_version": "102.0"
    }
  },
  "permissions": [
    "menus",
    "messagesRead",
    "nativeMessaging",
    "notifications"
  ],
  "default_locale": "en",
  "background": {
    "scripts": ["background.js"]
  }
}
